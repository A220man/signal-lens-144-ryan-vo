# Application
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./signal_lens.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=signal-lens
KEYCLOAK_CLIENT_ID=signal-lens-client
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER_URL=http://localhost:8080/realms/signal-lens

# LLM Providers
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# Demo mode (local only - REFUSES in production)
DEMO_MODE=false
